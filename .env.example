# Copy to apps/web/.env.local (web) and apps/worker/.env (worker). Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# For local development, `supabase status -o env` prints the local URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker only (ADR 0004) — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# The single owner account (ADR 0012); only this email can sign up without an invite
NEXUS_OWNER_EMAIL=

# Error reporting (optional; errors are only logged when unset)
# Web app (public by design: a DSN can only submit events)
NEXT_PUBLIC_SENTRY_DSN=
# Worker
SENTRY_DSN=
# Source-map upload at build time; set in Vercel only, marked Sensitive
SENTRY_AUTH_TOKEN=

# Model providers (ADR 0008). Only Anthropic and OpenAI have live adapters so far.
XAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Recorded replies for local development and Playwright. Ignored unless Supabase is on localhost.
# Never set this on a hosted environment.
NEXUS_MODEL_FIXTURE=0
# Recorded agent plans for local development. Ignored unless Supabase is on localhost.
NEXUS_AGENT_FIXTURE=0
# Direct Postgres URL for the agent queue (pg-boss). Local: the DB_URL from `supabase status`.
DATABASE_URL=
# WebSocket address of the worker terminal. Local default is ws://127.0.0.1:8787
WORKER_WS_URL=
# Worker only (ADR 0019). Managed sandbox key: set it on Railway, marked secret. Without it the
# worker uses Docker, which Railway cannot run.
E2B_API_KEY=
# Optional custom E2B template (another Node version).
E2B_TEMPLATE=
# docker | e2b | recorded. Unset: e2b with a key, recorded in local fixture mode, else docker.
NEXUS_SANDBOX_DRIVER=
# Docker driver only: "bridge" gives the local sandbox plain network (no host filtering).
NEXUS_SANDBOX_DOCKER_NETWORK=

# Global spend cap in USD (ADR 0007)
NEXUS_GLOBAL_MONTHLY_BUDGET_USD=20
