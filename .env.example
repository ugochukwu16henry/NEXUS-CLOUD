# Copy to apps/web/.env.local (web) and apps/worker/.env (worker). Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# For local development, `supabase status -o env` prints the local URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker only (ADR 0004) — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# The single owner account (ADR 0012); only this email can sign up without an invite
NEXUS_OWNER_EMAIL=

# Error reporting (optional; errors are only logged when unset)
SENTRY_DSN=

# Model providers (ADR 0008) — added in Sprint 5
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Global spend cap in USD (ADR 0007)
NEXUS_GLOBAL_MONTHLY_BUDGET_USD=20
