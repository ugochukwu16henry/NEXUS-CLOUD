{
  "name": "@nexus/hub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs --external:@nestjs/microservices --external:@nestjs/websockets --external:class-transformer --external:class-validator --external:pg-native",
    "start": "node dist/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --mode db",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nexus/money": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15"
  }
}
