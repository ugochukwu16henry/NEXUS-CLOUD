# Copy to apps/hub-api/.env and fill in. Never commit real keys.
# Customer zone only (ADR 0015): these keys never go into the Nexus Cloud app or worker.
PORT=4000
# Local: a database on the local Supabase Postgres, migrated with `pnpm --filter @nexus/hub-api db:migrate`
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/nexus_hub

# Paystack (test keys during development)
PAYSTACK_SECRET_KEY=

# Providers (from Hub Sprint 3); separate keys from Nexus Cloud's
XAI_API_KEY=
GROQ_API_KEY=
